@@ -0,0 +1,11 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package derphttp
+
+// An explicit per-device carrier owns DERP dialing, including latency probes.
+// Ambient HTTP proxies must not substitute another path behind the caller.
+func (c *Client) useConfiguredDERPDialerLX() bool {
+	d, ok := c.netMon.Dialer().(interface{ TailscaleUseConfiguredDialerLX() bool })
+	return ok && d.TailscaleUseConfiguredDialerLX()
+}
