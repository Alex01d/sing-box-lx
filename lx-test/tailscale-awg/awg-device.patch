+				}
+			}
+
+			latest := ruc.currentConn()
+			latestReadDone := make(chan error, 1)
+			go func() {
+				_, _, err := latest.ReadFromUDPAddrPort(make([]byte, 1))
+				latestReadDone <- err
+			}()
+			if err := ruc.Close(); err != nil && err != net.ErrClosed {
+				t.Fatalf("final close: %v", err)
+			}
+			select {
+			case err := <-latestReadDone:
+				if err != net.ErrClosed {
+					t.Fatalf("latest connection read error = %v, want %v", err, net.ErrClosed)
+				}
+			case <-time.After(2 * time.Second):
+				_ = latest.Close()
+				t.Fatal("latest connection remained blocked after final close")
+			}
+		})
+	}
