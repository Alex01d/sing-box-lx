+			if err := c.bindSocket(&ruc, network, keepCurrentPort); err != nil {
+				t.Fatalf("initial bindSocket: %v", err)
+			}
+
+			for rebind := range 3 {
+				old := ruc.currentConn().(*blockForeverConn)
+
+				readDone := make(chan error, 1)
+				go func() {
+					_, _, err := old.ReadFromUDPAddrPort(make([]byte, 1))
+					readDone <- err
+				}()
