new file mode 100644
--- /dev/null
+++ b/wgengine/wireguard_classifier_lx.go
@@ -0,0 +1,24 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package wgengine
+
+import "github.com/sagernet/wireguard-go/device"
+
+func (e *userspaceEngine) installWireGuardClassifierLX() {
+	e.magicConn.SetWireGuardPacketClassifierLX(func(b []byte) uint32 {
+		if len(b) < device.MinMessageSize {
+			return device.MessageUnknownType
+		}
+		cipher, err := e.wgdev.HeaderProtectionCipher(b)
+		if err != nil {
+			return device.MessageUnknownType
+		}
+		var mask [8]byte
+		if cipher != nil {
+			cipher.XORKeyStream(mask[:], mask[:])
+		}
+		_, kind, _ := e.wgdev.DeterminePacketTypeAndPadding(b, mask[:])
+		return kind
+	})
+}
diff --git a/wgengine/magicsock/wireguard_classifier_lx.go b/wgengine/magicsock/wireguard_classifier_lx.go
new file mode 100644
--- /dev/null
+++ b/wgengine/magicsock/wireguard_classifier_lx.go
@@ -0,0 +1,47 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package magicsock
+
+import (
+	"errors"
+	"io"
+
+	"github.com/sagernet/wireguard-go/device"
+)
+
+// SetWireGuardPacketClassifierLX installs the configured device's framing
+// classifier. Packet authentication remains the WireGuard device's job.
+func (c *Conn) SetWireGuardPacketClassifierLX(f func([]byte) uint32) {
+	c.wireGuardPacketClassifier.Store(f)
+}
+
+func (c *Conn) classifyWirePacketLX(b []byte) (packetLooksLikeType, bool) {
+	kind, geneve := packetLooksLike(b)
+	if f := c.wireGuardPacketClassifier.Load(); f != nil {
+		// Preserve complete native control signatures even for broad AWG H ranges.
+		// Geneve is checked only after the configured device's naked framing.
+		if !geneve && (kind == packetLooksLikeDisco || kind == packetLooksLikeSTUNBinding) {
+			return kind, false
+		}
+		if f(b) != device.MessageUnknownType {
+			return packetLooksLikeWireGuard, false
+		}
+	}
+	return kind, geneve
+}
+
+func (c *Conn) isWireGuardInitiationLX(b []byte) bool {
+	if f := c.wireGuardPacketClassifier.Load(); f != nil {
+		return f(b) == device.MessageInitiationType
+	}
+	return looksLikeInitiationMsg(b)
+}
+
+// Avoid even the native raw-DISCO self-test socket when an explicit carrier is used.
+func (c *Conn) listenRawDiscoLX(family string) (io.Closer, error) {
+	if c.packetListenerLX != nil || c.forceDERPLX {
+		return nil, errors.New("native raw disco disabled for explicit underlay")
+	}
+	return c.listenRawDisco(family)
+}
diff --git a/wgengine/magicsock/awg_framing_lx_test.go b/wgengine/magicsock/awg_framing_lx_test.go
new file mode 100644
--- /dev/null
+++ b/wgengine/magicsock/awg_framing_lx_test.go
@@ -0,0 +1,69 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package magicsock
+
+import (
+	"encoding/binary"
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/tailscale/disco"
+	"github.com/sagernet/tailscale/net/packet"
+	"github.com/sagernet/wireguard-go/device"
+)
+
+func TestAWGPaddingIsNotGeneveLX(t *testing.T) {
+	// A valid random S1 prefix can also look like a Geneve header. Stripping
+	// it destroys AWG framing before the configured device sees the packet.
+	b := make([]byte, 16+device.MessageInitiationSize)
+	binary.BigEndian.PutUint16(b[2:4], packet.GeneveProtocolWireGuard)
+	binary.LittleEndian.PutUint32(b[16:20], 100001)
+	// Without the optional classifier, upstream correctly sees Geneve.
+	if _, geneve := packetLooksLike(b); !geneve {
+		t.Fatal("fixture no longer exercises the Geneve collision")
+	}
+	c := new(Conn)
+	c.SetWireGuardPacketClassifierLX(func(packet []byte) uint32 {
+		if len(packet) == len(b) && binary.LittleEndian.Uint32(packet[16:20]) == 100001 {
+			return device.MessageInitiationType
+		}
+		return device.MessageUnknownType
+	})
+	kind, geneve := c.classifyWirePacketLX(b)
+	if kind != packetLooksLikeWireGuard || geneve {
+		t.Fatalf("AWG padding was classified as outer framing: kind=%v geneve=%v", kind, geneve)
+	}
+	if !c.isWireGuardInitiationLX(b) {
+		t.Fatal("AWG initiation is not recognized for peer-relay JIT lookup")
+	}
+	// Unproven peer-relay framing is explicitly refused, rather than stripped
+	// and handed to the AWG device as if it were a supported data path.
+	c.havePrivateKey.Store(true)
+	c.peerMap = newPeerMap()
+	encapsulated := make([]byte, 8+device.MessageInitiationSize)
+	binary.BigEndian.PutUint16(encapsulated[2:4], packet.GeneveProtocolWireGuard)
+	if _, _, _, ok := c.receiveIP(encapsulated, netip.MustParseAddrPort("192.0.2.1:41641"), new(epAddrEndpointCache)); ok {
+		t.Fatal("unsupported AWG peer-relay packet was accepted")
+	}
+	plain := new(Conn)
+	if _, geneve := plain.classifyWirePacketLX(b); !geneve {
+		t.Fatal("nil classifier changed upstream framing")
+	}
+	// Even a broad data-header range cannot consume full control signatures.
+	c.SetWireGuardPacketClassifierLX(func([]byte) uint32 { return device.MessageTransportType })
+	stun := make([]byte, 20)
+	stun[1] = 1
+	binary.BigEndian.PutUint32(stun[4:8], 0x2112a442)
+	discoPacket := make([]byte, discoHeaderLen+24)
+	copy(discoPacket, disco.Magic)
+	for _, control := range []struct {
+		packet []byte
+		want   packetLooksLikeType
+	}{{stun, packetLooksLikeSTUNBinding}, {discoPacket, packetLooksLikeDisco}} {
+		if kind, geneve := c.classifyWirePacketLX(control.packet); kind != control.want || geneve {
+			t.Fatal("AWG classifier consumed native control traffic")
+		}
+	}
+
+}
