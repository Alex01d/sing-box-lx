+
+//go:build !linux && !ts_omit_serve
+
+package ipnlocal
+
+import (
+	"context"
+	"net"
+)
+
+// dialServeUnixSocketSafe dials socketPath directly. This platform has no
+// openat2(2) equivalent, so swapping the path can still retarget the
+// connect. The caller re-checks the connected peer.
+func (b *LocalBackend) dialServeUnixSocketSafe(ctx context.Context, socketPath string) (net.Conn, error) {
+	var d net.Dialer
+	return d.DialContext(ctx, "unix", socketPath)
+}
diff --git a/ipn/ipnlocal/serve_security_lx_test.go b/ipn/ipnlocal/serve_security_lx_test.go
new file mode 100644
--- /dev/null
+++ b/ipn/ipnlocal/serve_security_lx_test.go
@@ -0,0 +1,69 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build unix && !ts_omit_serve
+
+package ipnlocal
+
+import (
+	"context"
+	"errors"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/sagernet/tailscale/tsd"
+)
+
+func TestServeUnixSocketSecurityBackportLX(t *testing.T) {
+	dir := t.TempDir()
+	privileged := filepath.Join(dir, "tailscaled.sock")
+	backend := filepath.Join(dir, "backend.sock")
+	p, err := net.Listen("unix", privileged)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	normal, err := net.Listen("unix", backend)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer normal.Close()
+	b := &LocalBackend{sys: &tsd.System{SocketPath: privileged}, logf: t.Logf}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	conn, err := b.dialServeUnixSocket(ctx, backend)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn.Close()
+	link := filepath.Join(dir, "alias.sock")
+	if err := os.Symlink(privileged, link); err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{privileged, link} {
+		conn, err := b.dialServeUnixSocket(ctx, path)
+		if conn != nil {
+			conn.Close()
+			t.Fatal("privileged socket was connected")
+		}
+		if !errors.Is(err, ErrProxyToTailscaledSocket) {
+			t.Fatalf("expected refusal for %s: %v", path, err)
+		}
+	}
+	// A backend path changed after configuration must be rechecked on dial.
+	normal.Close()
+	if err := os.Symlink(privileged, backend); err != nil {
+		t.Fatal(err)
+	}
+	conn, err = b.dialServeUnixSocket(ctx, backend)
+	if conn != nil {
+		conn.Close()
+		t.Fatal("swapped backend connected to LocalAPI")
+	}
+	if !errors.Is(err, ErrProxyToTailscaledSocket) {
+		t.Fatalf("swapped backend not refused: %v", err)
+	}
+}
